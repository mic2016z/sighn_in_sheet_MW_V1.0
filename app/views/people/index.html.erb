<% content_for :title, "People" %>
<%= render "shared/nav" %>

<div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">People</h1>
      <p class="text-sm text-slate-500">Everyone who can appear in the tap-to-sign-in list</p>
    </div>
    <%= link_to "+ Bulk add", new_person_path, class: "rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-500 transition" %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 overflow-hidden">
    <% if @people.none? %>
      <div class="px-4 py-16 text-center">
        <p class="text-4xl mb-2">👥</p>
        <p class="text-slate-400 font-medium">Nobody added yet.</p>
        <p class="text-slate-300 text-xs mt-1">The sign-in page still works — people can just type their name.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y divide-slate-100 sm:divide-y-0">
        <% @people.each do |person| %>
          <div class="flex items-center gap-3 px-5 py-3 sm:border-b sm:border-slate-100">
            <%= avatar(person.full_name) %>
            <span class="font-medium text-slate-900"><%= person.full_name %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% content_for :title, "New location" %>
<%= render "shared/nav" %>

<div class="max-w-md mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 mb-6">New location</h1>

  <%= form_with model: @location, url: locations_path, class: "bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 p-6 space-y-5" do |f| %>
    <% if @location.errors.any? %>
      <p class="text-sm text-rose-600"><%= @location.errors.full_messages.to_sentence %></p>
    <% end %>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1.5">Location name</label>
      <%= f.text_field :name, required: true, placeholder: "e.g. Front Desk",
            class: "w-full rounded-xl border-0 ring-1 ring-slate-300 px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-teal-500" %>
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1.5">Programs <span class="font-normal text-slate-400">(comma separated — leave blank if there's just one)</span></label>
      <input type="text" name="programs" placeholder="e.g. Op Shop, Food Relief"
             class="w-full rounded-xl border-0 ring-1 ring-slate-300 px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-teal-500">
    </div>

    <%= f.submit "Create & print poster", class: "w-full rounded-xl bg-teal-600 px-4 py-3.5 font-bold text-white hover:bg-teal-500 transition cursor-pointer" %>
  <% end %>
</div>

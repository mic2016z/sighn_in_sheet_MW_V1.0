<% content_for :title, "Locations" %>
<%= render "shared/nav" %>

<div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Locations</h1>
      <p class="text-sm text-slate-500">Each location gets its own QR poster and sign-in page</p>
    </div>
    <%= link_to "+ New location", new_location_path, class: "rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-500 transition" %>
  </div>

  <div class="space-y-3">
    <% @locations.each do |location| %>
      <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 px-5 py-4 flex items-center justify-between gap-4 flex-wrap">
        <div class="min-w-0">
          <p class="font-bold text-slate-900 text-lg"><%= location.name %></p>
          <p class="text-xs text-slate-400 truncate"><%= sign_in_location_url(location.slug) %></p>
          <% if location.programs.any? %>
            <div class="flex gap-1.5 mt-2 flex-wrap">
              <% location.programs.each do |program| %>
                <span class="rounded-full bg-slate-100 text-slate-600 text-[11px] font-semibold px-2.5 py-0.5"><%= program %></span>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="flex gap-2 shrink-0">
          <%= link_to "Sign-in page", sign_in_location_path(location.slug), class: "rounded-xl px-3.5 py-2 text-sm font-semibold text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50 transition" %>
          <%= link_to "Print poster", poster_location_path(location), class: "rounded-xl px-3.5 py-2 text-sm font-semibold text-teal-700 ring-1 ring-teal-200 hover:bg-teal-50 transition" %>
        </div>
      </div>
    <% end %>
    <% if @locations.none? %>
      <div class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5 px-4 py-16 text-center">
        <p class="text-4xl mb-2">📍</p>
        <p class="text-slate-400 font-medium">No locations yet — create one to print its poster.</p>
      </div>
    <% end %>
  </div>
</div>

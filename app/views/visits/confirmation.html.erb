<% content_for :title, @result == :signed_in ? "Signed in" : "Signed out" %>

<div class="min-h-screen flex items-center justify-center px-5 <%= @result == :signed_in ? 'bg-teal-600' : 'bg-slate-800' %>">
  <meta http-equiv="refresh" content="5;url=<%= sign_in_location_path(@location.slug) %>">

  <div class="text-center text-white max-w-sm">
    <% if @result == :signed_in %>
      <div class="mx-auto size-24 rounded-full bg-white/20 flex items-center justify-center text-5xl mb-6">✓</div>
      <h1 class="text-4xl font-black tracking-tight">Welcome,<br><%= @visit.person_name.split.first %>!</h1>
      <p class="mt-3 text-lg text-teal-100">Signed in at <span class="font-bold text-white tabular-nums"><%= @visit.signed_in_at.strftime("%-l:%M %p") %></span></p>
      <% if @visit.signed? %>
        <img src="<%= @visit.signature_data %>" alt="Your signature" class="mx-auto mt-4 h-14 bg-white/95 rounded-lg px-3 py-1">
      <% end %>
    <% else %>
      <div class="mx-auto size-24 rounded-full bg-white/10 flex items-center justify-center text-5xl mb-6">👋</div>
      <h1 class="text-4xl font-black tracking-tight">See you,<br><%= @visit.person_name.split.first %>!</h1>
      <p class="mt-3 text-lg text-slate-300">
        Signed out at <span class="font-bold text-white tabular-nums"><%= @visit.signed_out_at.strftime("%-l:%M %p") %></span><br>
        <span class="text-sm text-slate-400"><%= distance_of_time_in_words(@visit.signed_in_at, @visit.signed_out_at) %> on site</span>
      </p>
    <% end %>
    <p class="mt-8 text-sm <%= @result == :signed_in ? 'text-teal-200' : 'text-slate-400' %>">This screen resets in a few seconds</p>
  </div>
</div>

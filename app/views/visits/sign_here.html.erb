<% content_for :title, "Sign here" %>

<div class="min-h-screen bg-slate-900 flex flex-col">
  <div class="max-w-md mx-auto px-5 py-8 flex flex-col gap-6 w-full flex-1">
    <header class="text-center text-white">
      <p class="text-xs uppercase tracking-[0.2em] text-teal-300 font-bold">Signing in at <%= @location.name %></p>
      <h1 class="text-3xl font-black tracking-tight mt-1"><%= @person.full_name %></h1>
    </header>

    <%= form_with url: confirm_sign_in_path(slug: @location.slug), method: :post,
          data: { controller: "signature-pad", turbo: false }, class: "flex-1 flex flex-col gap-4" do %>
      <%= hidden_field_tag :person_id, @person.id %>
      <%= hidden_field_tag :program, @program %>
      <%= hidden_field_tag :signature, "", data: { signature_pad_target: "field" } %>

      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm font-bold text-slate-300">Sign here to confirm it's you</label>
          <button type="button" data-action="signature-pad#clear" class="text-xs font-semibold text-teal-300 hover:text-teal-200">Clear</button>
        </div>
        <div class="relative bg-white rounded-2xl shadow-lg ring-1 ring-white/10" style="height: 220px;">
          <p data-signature-pad-target="placeholder" class="absolute inset-0 flex items-center justify-center text-slate-300 text-lg pointer-events-none select-none">✍️ Sign with your finger or mouse</p>
          <canvas data-signature-pad-target="canvas" class="absolute inset-0 w-full h-full rounded-2xl touch-none"></canvas>
        </div>
        <p class="mt-2 text-xs text-slate-500 text-center">A signature is optional but helps confirm it was really you.</p>
      </div>

      <div class="mt-auto flex gap-3 pt-2">
        <%= link_to "← Back", sign_in_location_path(@location.slug), class: "rounded-2xl px-5 py-4 font-semibold text-slate-300 ring-1 ring-white/10 hover:bg-white/5 transition" %>
        <%= submit_tag "Confirm sign in", class: "flex-1 rounded-2xl bg-teal-500 px-4 py-4 text-lg font-black text-slate-900 hover:bg-teal-400 active:scale-[0.98] transition cursor-pointer shadow-lg" %>
      </div>
    <% end %>
  </div>
</div>
